# Git ignore file for root directory
.env
node_modules/
outputs/
temp/
static/
__pycache__/
*.pyc
venv/
.DS_Store
*.log
bin/

# Terraform — never push these
terraform/.terraform/
terraform/terraform.tfstate
terraform/terraform.tfstate.backup
terraform/.terraform.lock.hcl

# AWS Keys / Secrets
*.pem
*.key
